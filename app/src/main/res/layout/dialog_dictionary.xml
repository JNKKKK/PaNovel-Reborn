<?xml version="1.0" encoding="utf-8"?>
<!--
  长按取词弹出的底部面板，
  颜色在代码里按 reader.config 的正文/背景色即时设置，以配合阅读页当前配色（含夜间），
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dictRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <!-- 拖拽提示条 -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_dict_drag_handle" />

    <!-- 匹配长度选择：瞬 / 瞬间 …，只在命中多个长度时显示 -->
    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 长度筹码在代码里以自绘圆角药丸TextView填充，避免Material Chip被主题样式覆盖 -->
        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 词头 + 拼音 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="true"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHeadword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="瞬间" />

        <TextView
            android:id="@+id/tvPinyin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="6dp"
            android:textSize="22sp"
            android:alpha="0.7"
            tools:text="shùnjiān" />
    </LinearLayout>

    <!-- 义项选择（多义项时才显示） -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabEntries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:tabGravity="start"
        app:tabIndicatorFullWidth="false"
        app:tabMode="scrollable"
        tools:visibility="visible" />

    <!-- 分隔线 -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:alpha="0.2" />

    <!-- 释义。用 NestedScrollView（而非 ScrollView）以便和 BottomSheetBehavior 协作嵌套滚动：
         展开后内容可以上下滚动，只有滚到顶部再下拉才会收起面板。高度上限由面板整体限高控制，
         不在这里写 maxHeight（ScrollView/NestedScrollView 都不认 android:maxHeight）。 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvDefinition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:textSize="16sp"
            android:textIsSelectable="true"
            tools:text="[in a twinkling; split-second] 一眨眼的工夫，转瞬之间。" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
