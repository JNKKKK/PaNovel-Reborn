<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-mode overrides (follow-system DayNight). Only colors that must flip for dark
     mode live here; everything else inherits the base values/colors.xml.

     colorPrimary is intentionally NOT overridden: the top/nav bars and the programmatic
     system-bar scrims (insets.kt / the reader) read R.color.colorPrimary and should stay
     dark grey in both modes. The reader's reading canvas is config-driven (ReaderConfig)
     and does not participate in DayNight. -->
<resources>
    <!-- Content text: near-white primary and a dimmed secondary on dark surfaces. -->
    <color name="textDefault">#b3ffffff</color>
    <color name="textBlack">#deffffff</color>

    <!-- Reader window background: dark so opening the reader doesn't flash white. -->
    <color name="readerWindowBackground">@color/md_grey_900</color>

    <!-- App bar at night: a darker grey than the surface, with light content. -->
    <color name="colorAppBar">@color/md_grey_900</color>
    <color name="colorOnAppBar">@android:color/white</color>
    <color name="colorOnAppBarHint">#99FFFFFF</color>

    <!-- Main-screen tabs at night: white selected text, dimmed unselected. -->
    <color name="tabTextColorSelected">@android:color/white</color>
    <color name="tabTextColorUnselected">@android:color/darker_gray</color>

    <!-- Neutral grey-scale surface/background at night. Clearly darker than the app bar
         (#212121) so the list reads as recessed below the lighter title bar. -->
    <color name="colorSurface">#121212</color>
    <color name="colorOnSurface">#deffffff</color>

    <!-- Dialog/popup surface: a little lighter than the #121212 content so popups stand out. -->
    <color name="colorDialogSurface">#242424</color>

    <!-- Pinned-item highlight: a subtle lift above the #121212 content, not a light band. -->
    <color name="pinnedItemBackground">#2a2a2a</color>

    <!-- Downloaded-chapter green: a lighter shade for legibility on the dark list. -->
    <color name="chapterDownloaded">@color/md_green_300</color>

    <!-- 可用性状态条：暗色列表上用更亮的色阶，灰条用高于 #121212 内容面的抬升色。 -->
    <color name="availabilityOk">@color/md_green_400</color>
    <color name="availabilityRecovered">@color/md_amber_400</color>
    <color name="availabilityFail">@color/md_red_400</color>
    <color name="availabilityUnknown">#3a3a3a</color>
</resources>
