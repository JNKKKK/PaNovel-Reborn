<resources>

    <!-- The toolbar forces a Light popup overlay (values/styles.xml) so the overflow menu
         reads as a normal light menu on the dark app bar in light mode. Under DayNight the
         popup window background follows the dark surface at night, so the forced-light
         text would be black-on-dark; override to a dark overlay at night for light text on
         the dark popup. -->
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />

</resources>
