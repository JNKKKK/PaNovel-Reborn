<resources>

    <!-- Base application theme. Material 3 with DayNight (follow-system dark mode): light
         and dark surfaces/window backgrounds are supplied automatically by the theme and
         the values-night overrides.

         Color-role mapping (important): M3 merged the "primary" and "accent" roles, so
         interactive elements — buttons, dialog text-buttons, and control tints (switch,
         checkbox, seekbar, radio) — all follow colorPrimary. We therefore map colorPrimary
         to the PINK ACCENT, which is legible on both light and dark surfaces (dark grey
         would vanish on a dark surface in night mode). colorSecondary keeps the accent too.

         The dark top/nav BARS are intentionally NOT driven by colorPrimary — they use the
         @color/colorPrimary *resource* (dark grey) directly (see activity_main / detail
         layouts and the programmatic scrims in insets.kt / the reader), so the bars stay
         dark in both modes regardless of this attribute. The reader's reading canvas is
         config-driven and does not participate in DayNight (see ReaderConfig / ROADMAP.md). -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textViewStyle">@style/AppTextViewStyle</item>
        <!-- Light title bar in day → dark status-bar icons; dark bar at night → light icons.
             Screens with an always-dark bar (detail image header, reader) override this. -->
        <item name="android:windowLightStatusBar">@bool/appBarLightStatusBar</item>
        <!-- Neutral grey-scale surfaces. MaterialComponents tints elevated surfaces by
             overlaying an "elevation overlay" color (defaults toward colorPrimary/on-surface)
             which can warm greys; pin surface/background to plain greys and disable the
             elevation overlay so the list/screen backgrounds stay neutral (DayNight via
             values-night). -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="android:colorBackground">@color/colorSurface</item>
        <item name="elevationOverlayEnabled">false</item>
        <!-- Secondary/variant on-surface text (e.g. preference summaries) defaults to M3's
             colorOnSurfaceVariant (#CAC4D0 dark, a lavender-grey that reads pinkish); pin it
             to the neutral DayNight secondary text color so it's plain grey, not tinted. -->
        <item name="colorOnSurfaceVariant">@color/textDefault</item>
        <!-- Material3 sets android:textColorPrimary/Secondary to its own literal on-surface
             colors (dark #E6E0E9 / #CAC4D0, a lavender cast), independent of colorOnSurface.
             Views that read these — notably preference titles/summaries via
             textAppearanceListItem — show that tint. Pin them to the neutral DayNight text
             colors so all primary/secondary text is plain grey-scale. -->
        <item name="android:textColorPrimary">@color/textBlack</item>
        <item name="android:textColorSecondary">@color/textDefault</item>
        <!-- Route all AlertDialogs (AppCompat and MaterialAlertDialogBuilder) through
             AppTheme.Dialog so their surfaces stay neutral grey-scale (M3's pink elevation
             overlay is neutralized there) instead of pink-tinted. -->
        <item name="alertDialogTheme">@style/AppTheme.Dialog</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.Dialog</item>
        <!-- The AndroidX preference library applies its own PreferenceThemeOverlay, which
             carries M3's default on-surface colors (a slightly lavender off-white that reads
             pinkish), shadowing ours. Point it at a custom overlay that re-pins the neutral
             surface colors. -->
        <item name="preferenceTheme">@style/AppTheme.Preference</item>
        <!-- M3 Snackbar defaults to the INVERSE surface (a light bar in dark mode) with a
             colorPrimary-tinted action, so it reads white-with-pink. Pin it to the neutral
             dialog surface with on-surface text and the pink accent action. -->
        <item name="snackbarStyle">@style/AppTheme.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/AppTheme.Snackbar.TextView</item>
        <item name="snackbarButtonStyle">@style/AppTheme.Snackbar.Button</item>
    </style>

    <style name="AppTheme.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/colorDialogSurface</item>
    </style>

    <style name="AppTheme.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>

    <style name="AppTheme.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/colorAccent</item>
    </style>

    <!-- Preference-screen theme: keep the library's layouts (PreferenceThemeOverlay) but
         re-pin the neutral on-surface colors so preference titles/summaries aren't tinted. -->
    <style name="AppTheme.Preference" parent="PreferenceThemeOverlay">
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
        <item name="android:textColorSecondary">@color/textDefault</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnSurfaceVariant">@color/textDefault</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- M3 FABs default their background to colorPrimaryContainer (an off-brand lavender);
         pin it to the pink accent so the read/star FABs keep the identity verified in the
         earlier phases. The icon tint stays white (also set per-FAB in the layouts). -->
    <style name="AppTheme.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="tint">@android:color/white</item>
    </style>

    <!-- Detail screen: dark image header behind the status bar in both modes, so always use
         light status-bar icons (override the DayNight bool inherited from AppTheme). -->
    <style name="AppTheme.NoActionBar.TranslateStatusBar">
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- On-bar content colors for the general activities' (DayNight) title bar. colorOnAppBar
         is itself DayNight (dark in day, white at night), so this one definition covers both
         modes: it tints the toolbar title, navigation/overflow icons, and menu-item text. -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3">
        <item name="android:textColorPrimary">@color/colorOnAppBar</item>
        <item name="android:textColorSecondary">@color/colorOnAppBar</item>
        <item name="colorControlNormal">@color/colorOnAppBar</item>
        <item name="colorOnSurface">@color/colorOnAppBar</item>
    </style>

    <!-- Always-dark bar (reader + detail image header): white content in both modes. These
         bars keep a dark @color/colorPrimary background and never go light. -->
    <style name="AppTheme.DarkAppBarOverlay" parent="ThemeOverlay.Material3.Dark">
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="colorControlNormal">@android:color/white</item>
    </style>

    <!-- Overflow/popup menu: match the app's content surface (colorSurface/colorOnSurface
         are DayNight, so this one definition covers both modes) instead of the default
         light/dark popup. Rounded Material3 popup shape. -->
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3">
        <item name="colorSurface">@color/colorDialogSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
        <item name="android:colorBackground">@color/colorDialogSurface</item>
        <!-- Popups sit at elevation; M3 tints elevated surfaces with colorPrimary (pink),
             which tints the menu background pinkish. Neutralize the elevation overlay (as the
             base theme does) so the popup stays plain grey-scale. colorSurfaceContainer is the
             role M3 menus actually use for their background, so pin it too. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@color/colorOnSurface</item>
        <item name="colorSurfaceContainer">@color/colorDialogSurface</item>
    </style>

    <!-- AlertDialog theme matching the app's content surface (DayNight via colorSurface/
         colorOnSurface), with M3's pink elevation overlay neutralized so dialog backgrounds
         stay plain grey-scale. Buttons stay the pink accent. -->
    <style name="AppTheme.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/colorDialogSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
        <!-- M3 MaterialAlertDialog setItems() rows take their color from colorOnSurfaceVariant
             (default dark #CAC4D0, a lavender-grey that reads pinkish), not textColorPrimary.
             Pin it to the neutral on-surface color so rows match the title. -->
        <item name="colorOnSurfaceVariant">@color/colorOnSurface</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@color/colorOnSurface</item>
        <item name="colorSurfaceContainerHigh">@color/colorDialogSurface</item>
    </style>

    <style name="FullscreenTheme" parent="AppTheme.NoActionBar">
        <item name="android:actionBarStyle">@style/FullscreenActionBarStyle</item>
        <item name="android:windowActionBarOverlay">true</item>
        <!-- DayNight-aware so the reader window doesn't flash white before the first page
             renders in dark mode. The reading canvas itself is config-driven (ReaderConfig)
             and independent of this. -->
        <item name="android:windowBackground">@color/readerWindowBackground</item>
        <!-- Reader status bar is DayNight (light day / dark night, via colorAppBar), so its
             icons follow the same bool as the rest of the app. The reader also asserts this
             at runtime (applyStatusBarAppearance). -->
        <item name="android:windowLightStatusBar">@bool/appBarLightStatusBar</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
        <item name="metaButtonBarButtonStyle">?android:attr/buttonBarButtonStyle</item>
    </style>

    <style name="FullscreenActionBarStyle" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="ReaderSettingsSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="text_value_ll">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="text_value_tv">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minEms">5</item>
        <item name="android:textColor">@color/textBlack</item>
    </style>

    <style name="text_value_et">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/textBlack</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="AppTextViewStyle" parent="@style/Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextSmall</item>
    </style>

    <style name="TextLarge">
        <item name="android:textColor">@color/textBlack</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextBody1">
        <item name="android:textColor">@color/textBlack</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextSmall">
        <item name="android:textColor">@color/textDefault</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
