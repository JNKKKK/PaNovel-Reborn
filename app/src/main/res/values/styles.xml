<resources>

    <!-- Base application theme. Full (non-bridge) Material Components theme: Material
         widgets are now styled by the Material design system. The color attributes below
         map the app's existing palette onto Material's semantic model (primary = dark
         grey, secondary = the pink accent) so the visual identity is preserved. M3 /
         DayNight migration is a later phase — see ROADMAP.md.

         colorPrimaryDark / colorAccent are kept for continuity with any AppCompat widget
         and because R.color.colorPrimary is also referenced directly in code (system-bar
         scrims in insets.kt / the reader). -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:textViewStyle">@style/AppTextViewStyle</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBar.TranslateStatusBar" />

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="FullscreenTheme" parent="AppTheme.NoActionBar">
        <item name="android:actionBarStyle">@style/FullscreenActionBarStyle</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
        <item name="metaButtonBarButtonStyle">?android:attr/buttonBarButtonStyle</item>
    </style>

    <style name="FullscreenActionBarStyle" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="ReaderSettingsSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="text_value_ll">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="text_value_tv">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minEms">5</item>
        <item name="android:textColor">@color/textBlack</item>
    </style>

    <style name="text_value_et">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/textBlack</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="AppTextViewStyle" parent="@style/Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextSmall</item>
    </style>

    <style name="TextLarge">
        <item name="android:textColor">@color/textBlack</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextBody1">
        <item name="android:textColor">@color/textBlack</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextSmall">
        <item name="android:textColor">@color/textDefault</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
