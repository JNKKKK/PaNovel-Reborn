<resources>

    <!-- Base application theme. Material 3 with DayNight (follow-system dark mode): light
         and dark surfaces/window backgrounds are supplied automatically by the theme and
         the values-night overrides.

         Color-role mapping (important): M3 merged the "primary" and "accent" roles, so
         interactive elements — buttons, dialog text-buttons, and control tints (switch,
         checkbox, seekbar, radio) — all follow colorPrimary. We therefore map colorPrimary
         to the PINK ACCENT, which is legible on both light and dark surfaces (dark grey
         would vanish on a dark surface in night mode). colorSecondary keeps the accent too.

         The dark top/nav BARS are intentionally NOT driven by colorPrimary — they use the
         @color/colorPrimary *resource* (dark grey) directly (see activity_main / detail
         layouts and the programmatic scrims in insets.kt / the reader), so the bars stay
         dark in both modes regardless of this attribute. The reader's reading canvas is
         config-driven and does not participate in DayNight (see ReaderConfig / ROADMAP.md). -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textViewStyle">@style/AppTextViewStyle</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- M3 FABs default their background to colorPrimaryContainer (an off-brand lavender);
         pin it to the pink accent so the read/star FABs keep the identity verified in the
         earlier phases. The icon tint stays white (also set per-FAB in the layouts). -->
    <style name="AppTheme.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="AppTheme.NoActionBar.TranslateStatusBar" />

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="FullscreenTheme" parent="AppTheme.NoActionBar">
        <item name="android:actionBarStyle">@style/FullscreenActionBarStyle</item>
        <item name="android:windowActionBarOverlay">true</item>
        <!-- DayNight-aware so the reader window doesn't flash white before the first page
             renders in dark mode. The reading canvas itself is config-driven (ReaderConfig)
             and independent of this. -->
        <item name="android:windowBackground">@color/readerWindowBackground</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
        <item name="metaButtonBarButtonStyle">?android:attr/buttonBarButtonStyle</item>
    </style>

    <style name="FullscreenActionBarStyle" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="ReaderSettingsSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="text_value_ll">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="text_value_tv">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minEms">5</item>
        <item name="android:textColor">@color/textBlack</item>
    </style>

    <style name="text_value_et">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/textBlack</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="AppTextViewStyle" parent="@style/Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextSmall</item>
    </style>

    <style name="TextLarge">
        <item name="android:textColor">@color/textBlack</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextBody1">
        <item name="android:textColor">@color/textBlack</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextSmall">
        <item name="android:textColor">@color/textDefault</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
